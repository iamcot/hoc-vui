# Lấy ở Supabase > Project Settings > API. Không có 2 biến này app chạy ở chế độ khách (lưu trên máy).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chỉ cần khi chạy tool tạo ảnh/âm thanh trên máy (npm run gen-assets). Đặt trong .env.local, không commit.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Giọng riêng cho môn Tập đọc (giọng chuẩn miền Bắc), dùng khi chạy --tapdoc. Để trống thì dùng ELEVENLABS_VOICE_ID
ELEVENLABS_TAPDOC_VOICE_ID=
# Model giọng đọc, mặc định eleven_multilingual_v2 (có tiếng Việt). Đổi được: eleven_v3, eleven_flash_v2_5
ELEVENLABS_MODEL=eleven_multilingual_v2
# Tùy chọn, tính phí riêng: OPENAI_API_KEY=

# Môn Tập đọc: nhận dạng giọng bé đọc (tùy chọn). Không đặt thì dùng nhận dạng của trình duyệt hoặc tự chấm.
# STT_PROVIDER=google   GOOGLE_STT_KEY=<API key Google Cloud, bật Cloud Speech-to-Text API>
# STT_PROVIDER=openai   OPENAI_API_KEY=<key>
# STT_PROVIDER=azure    AZURE_SPEECH_KEY=<key>, AZURE_SPEECH_REGION=southeastasia (vùng của resource Speech)
# STT_PROVIDER=aws      AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION=ap-southeast-1 (IAM: transcribe:StartStreamTranscription)
STT_PROVIDER=
GOOGLE_STT_KEY=
