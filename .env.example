# Lấy ở Supabase > Project Settings > API. Không có 2 biến này app chạy ở chế độ khách (lưu trên máy).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chỉ cần khi chạy tool tạo ảnh/âm thanh trên máy (npm run gen-assets). Đặt trong .env.local, không commit.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Model giọng đọc, mặc định eleven_multilingual_v2 (có tiếng Việt). Đổi được: eleven_v3, eleven_flash_v2_5
ELEVENLABS_MODEL=eleven_multilingual_v2
# Tùy chọn, tính phí riêng: OPENAI_API_KEY=
